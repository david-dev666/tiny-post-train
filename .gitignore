# 权重与输出，体积大，不进版本库
# 注意用 dir/* + !dir/.gitkeep：如果整个目录写 dir/ 被忽略，
# 里面的 .gitkeep 也无法被重新包含，clone 后目录就不存在。
weights/*
!weights/.gitkeep
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
wandb/
evals/*.json
evals/*.log

# 评测产物。结果 json 存了每题的生成原文（判分能离线重放的前提），
# 但一份约 9MB，三份就 27MB —— 不进版本库。
# report.html 只有 25KB 且能 diff，保留。
# archive/ 是被换掉的旧推理引擎的结果，只作本地存档。
evals/results/*.json
evals/archive/

# 数据
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# 个人记录与本地 AI 规则，只留本地，不进版本库
notes/
.codebuddy/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# 编辑器与系统
.vscode/
.idea/
.DS_Store
.ipynb_checkpoints/

# 浏览器自动化调试产物（playwright-cli 的快照/日志）
.playwright-cli/
